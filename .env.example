MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=eventiq
AUTH_SECRET=replace-with-a-random-32-byte-or-longer-secret
# Optional: AI event planning using an OpenAI-compatible API
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Ticket confirmation email (Resend)
RESEND_API_KEY=
TICKET_EMAIL_FROM=

# Domain-free Gmail sender (an app password, never a regular account password)
TICKET_GMAIL_ADDRESS=
TICKET_GMAIL_APP_PASSWORD=

# Gemini-powered public event chatbot
GEMINI_API_KEY=
